# Copy this file to .env and fill in your key:
#     cp .env.example .env
#
# .env is gitignored, .env.example is committed — so the shape of the config is
# in version control but the secret never is.

# The only required variable. Read by app/main.py at import time, which never
# overrides a value already exported in your shell.
ANTHROPIC_API_KEY=sk-ant-...
